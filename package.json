{
  "name": "collab-canvas",
  "version": "0.1.0",
  "private": true,
  "description": "Real-time collaborative whiteboard built on a hand-written CRDT.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/crdt",
    "packages/server",
    "packages/web",
    "e2e"
  ],
  "scripts": {
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "test": "tsc -b && npm run test --workspaces --if-present",
    "dev": "tsc -b && concurrently -k -n server,web \"npm run dev -w @collab-canvas/server\" \"npm run dev -w @collab-canvas/web\"",
    "e2e": "playwright test --trace off"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.5",
    "concurrently": "10.0.7",
    "eslint": "10.14.0",
    "fast-check": "4.10.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vite": "8.3.7",
    "vitest": "5.1.0"
  }
}
