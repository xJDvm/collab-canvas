{
  "name": "collab-canvas",
  "version": "0.1.0",
  "private": true,
  "description": "Real-time collaborative whiteboard built on a hand-written CRDT.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/crdt",
    "packages/server",
    "packages/web",
    "e2e"
  ],
  "scripts": {
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "test": "npm run test --workspaces --if-present",
